# =========================================================================
# AQUANEX ENVIRONMENT CONFIGURATION
# =========================================================================

# Frontend API Target
VITE_API_URL=http://localhost:8000

# Database Engine Mode: 'sqlite' (default local demo) or 'supabase'
DATABASE_MODE=sqlite
DATABASE_URL=sqlite:///./aquanex.db

# Optional Supabase Cloud Credentials
# Leave empty for automatic local SQLite fallback mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
